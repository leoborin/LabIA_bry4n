# Esqueleto: configurações propostas; integração e validação pendentes.
# Não contém segredos reais. CHANGE_ME precisa ser substituído na implementação.
# Variáveis VITE_* são públicas e não devem receber credenciais.
LABAI_BRY4N_ENV=local
API_PORT=8080
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://labai_bry4n:CHANGE_ME@localhost:5432/labai_bry4n
OIDC_ISSUER=http://localhost:8081/realms/labai-bry4n
OIDC_AUDIENCE=labai-bry4n-api
OIDC_CLIENT_ID=labai-bry4n-web
OIDC_JWKS_URL=http://localhost:8081/realms/labai-bry4n/protocol/openid-connect/certs
AUTH_DEV_BYPASS=false
TRANSPORT=postgres
PUBSUB_EMULATOR_HOST=
GCP_PROJECT_ID=
GCP_REGION=
GCS_BUCKET_ARTIFACTS=
BIGQUERY_DATASET=
BIGQUERY_MAX_BYTES_BILLED=1073741824
MODEL_REGISTRY_URI=file:./artifacts/registry
RUN_MAX_ATTEMPTS=3
RUN_DEADLINE_SECONDS=600
WORKER_CONCURRENCY=1
JEV_ENABLED=false
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
OTEL_SERVICE_NAME=labai-bry4n-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
VITE_API_BASE_URL=http://localhost:8080
VITE_OIDC_ISSUER=http://localhost:8081/realms/labai-bry4n
VITE_OIDC_CLIENT_ID=labai-bry4n-web
VITE_OIDC_AUDIENCE=labai-bry4n-api
